{
  "name": "serial-logger",
  "version": "2.8.59",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:https": "ng serve --ssl true",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:prod": "npx serve -s dist/serial-logger && open http://localhost:5000",
    "build:prod": "ng build",
    "bump:version": "node scripts/bump-version.mjs",
    "bump:build": "node scripts/bump-and-deploy.mjs",
    "generate:cmdr-types": "../../.venv1/bin/python ../../scripts/export_cmdr_openapi.py --out tmp/cmdr-openapi.json && npx openapi-typescript@latest tmp/cmdr-openapi.json -o src/app/api/generated/cmdr-api.types.ts",
    "deploy:bauklank-micros-api": "node scripts/deploy-bauklank.mjs",
    "deploy:bauklank-studio": "npm run deploy:bauklank-micros-api"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/service-worker": "^22.1.4",
    "@angular/cdk": "^22.1.0",
    "@fontsource/dseg7-classic": "^5.2.5",
    "@primeuix/themes": "^3.0.0",
    "marked-katex-extension": "^5.0.0",
    "mermaid": "^11.15.0",
    "ngx-json-viewer": "^3.2.1",
    "ngx-markdown": "^22.0.0",
    "primeicons": "^8.0.0",
    "primeng": "^22.1.0",
    "qr-scanner": "^1.4.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "baseline-browser-mapping": "^2.10.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}